# --- Provider API keys (read directly by LiteLLM) ---
GROQ_API_KEY=your-groq-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# --- Model ids per alias (LiteLLM syntax: <provider>/<model-id>) ---
# Primary: High quality / default model
MODEL_PRIMARY=groq/llama-3.3-70b-versatile

# Strong: High-reasoning model for complex tickets
MODEL_STRONG=gemini/gemini-1.5-pro

# Small: Lightweight, fast model for fastpath routing
MODEL_SMALL=groq/llama-3.1-8b-instant

# --- Fallback deployments on the secondary provider ---
# Primary fallback routes to Gemini if Groq fails
MODEL_PRIMARY_FALLBACK=gemini/gemini-1.5-flash

# Strong fallback routes to Groq's high-capacity model
MODEL_STRONG_FALLBACK=groq/llama-3.3-70b-versatile

# Small fallback routes to Gemini's fast/lite model
MODEL_SMALL_FALLBACK=gemini/gemini-1.5-flash

# --- Gateway tuning (defaults) ---
TIMEOUT_SMALL_S=10
TIMEOUT_PRIMARY_S=20
TIMEOUT_STRONG_S=30
LLM_MAX_RETRIES=2
BACKOFF_BASE_S=0.5
BACKOFF_CAP_S=8
MAX_RETRY_AFTER_S=10
BREAKER_FAILURES=5
BREAKER_COOLDOWN_S=30